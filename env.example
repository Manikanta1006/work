# The backend URL is hardcoded in src/lib/backendUrl.js so nothing needs
# configuring in Vercel. Every environment, including local dev, talks to the
# live AWS backend at:
# https://ye49m4unx0.execute-api.ap-south-1.amazonaws.com
#
# To point local dev at a locally running indq-backend instead, temporarily
# edit BACKEND_URL in src/lib/backendUrl.js to http://localhost:4000.
#
# ---------------------------------------------------------------------------
# Chatbot (src/routes/api/chat/+server.ts)
#
# The assistant answers from src/lib/server/knowledge.txt. All server-side
# only (no PUBLIC_ prefix); set them in the Vercel dashboard for production.
#
# GROQ_API_KEY        free key at https://console.groq.com/keys (primary)
# OPENROUTER_API_KEY  free key at https://openrouter.ai/keys (backup)
# CHAT_MODELS         comma-separated chain, tried in order on failure.
#   "groq:" prefix -> Groq API, anything else -> OpenRouter.
#   Groq free tier ~1000 req/day per model but ~8000 tokens/min, so the
#   chain falls through to the next model on a burst.
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CHAT_MODELS="groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,nex-agi/nex-n2.5-mini:free,inclusionai/ling-3.0-flash-sante:free"
#
# GOOGLE_SHEET_WEBHOOK_URL  logs every Q&A to a Google Sheet. Deploy the Apps
#   Script in docs/chatbot.md as a web app and paste its /exec URL here.
# GOOGLE_SHEET_TOKEN        any random string; must match TOKEN in the script.
# Leave both blank to disable logging.
GOOGLE_SHEET_WEBHOOK_URL=""
GOOGLE_SHEET_TOKEN=""
